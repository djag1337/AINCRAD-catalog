{
  "apiVersion": 1,
  "author": "AINCRAD",
  "description": "Greets you with the classic SAO message when AINCRAD starts, and counts how often you open the launcher.",
  "id": "aincrad.welcome",
  "name": "Welcome Message",
  "permissions": [],
  "provides": {
    "scripts": [
      {
        "steps": [
          {
            "fields": {},
            "inputs": {
              "text": {
                "fields": {
                  "value": "Welcome to Sword Art Online!"
                },
                "op": "literal"
              }
            },
            "op": "looks.message"
          }
        ],
        "trigger": {
          "fields": {},
          "inputs": {},
          "op": "ext.started"
        }
      },
      {
        "steps": [
          {
            "fields": {
              "name": "opens"
            },
            "inputs": {
              "value": {
                "fields": {
                  "value": "1"
                },
                "op": "literal"
              }
            },
            "op": "var.change"
          },
          {
            "fields": {},
            "inputs": {
              "name": {
                "fields": {
                  "value": "Opens"
                },
                "op": "literal"
              },
              "percent": {
                "fields": {
                  "value": ""
                },
                "op": "literal"
              },
              "text": {
                "fields": {},
                "inputs": {
                  "a": {
                    "fields": {
                      "name": "opens"
                    },
                    "inputs": {},
                    "op": "var.get"
                  },
                  "b": {
                    "fields": {
                      "value": " opens today"
                    },
                    "op": "literal"
                  }
                },
                "op": "op.join"
              }
            },
            "op": "looks.gauge"
          }
        ],
        "trigger": {
          "fields": {},
          "inputs": {},
          "op": "launcher.opened"
        }
      }
    ],
    "widgets": [
      {
        "name": "Launcher counter",
        "widget": {
          "height": 70,
          "props": {
            "label": "Opens",
            "show": "text",
            "source": "script:aincrad.welcome/Opens"
          },
          "type": "stat",
          "width": 260
        }
      }
    ]
  },
  "version": "1.0"
}