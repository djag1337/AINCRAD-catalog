{
  "apiVersion": 1,
  "author": "AINCRAD",
  "description": "Every hour your Mac stays up clears a floor of Aincrad. A gauge shows the floor out of 100.",
  "id": "aincrad.floor-counter",
  "name": "Floor Counter",
  "permissions": [],
  "provides": {
    "scripts": [
      {
        "steps": [
          {
            "fields": {
              "name": "floor"
            },
            "inputs": {
              "value": {
                "fields": {},
                "inputs": {
                  "a": {
                    "fields": {
                      "reading": "uptime hours"
                    },
                    "inputs": {},
                    "op": "sense.reading"
                  },
                  "b": {
                    "fields": {
                      "value": "1"
                    },
                    "op": "literal"
                  }
                },
                "op": "op.add"
              }
            },
            "op": "var.set"
          },
          {
            "body": [
              {
                "fields": {
                  "name": "floor"
                },
                "inputs": {
                  "value": {
                    "fields": {
                      "value": "100"
                    },
                    "op": "literal"
                  }
                },
                "op": "var.set"
              }
            ],
            "fields": {},
            "inputs": {
              "condition": {
                "fields": {},
                "inputs": {
                  "a": {
                    "fields": {
                      "name": "floor"
                    },
                    "inputs": {},
                    "op": "var.get"
                  },
                  "b": {
                    "fields": {
                      "value": "100"
                    },
                    "op": "literal"
                  }
                },
                "op": "op.gt"
              }
            },
            "op": "control.if"
          },
          {
            "fields": {},
            "inputs": {
              "name": {
                "fields": {
                  "value": "Floor"
                },
                "op": "literal"
              },
              "percent": {
                "fields": {
                  "name": "floor"
                },
                "inputs": {},
                "op": "var.get"
              },
              "text": {
                "fields": {},
                "inputs": {
                  "a": {
                    "fields": {},
                    "inputs": {
                      "a": {
                        "fields": {
                          "value": "Floor "
                        },
                        "op": "literal"
                      },
                      "b": {
                        "fields": {
                          "name": "floor"
                        },
                        "inputs": {},
                        "op": "var.get"
                      }
                    },
                    "op": "op.join"
                  },
                  "b": {
                    "fields": {
                      "value": " / 100"
                    },
                    "op": "literal"
                  }
                },
                "op": "op.join"
              }
            },
            "op": "looks.gauge"
          }
        ],
        "trigger": {
          "fields": {},
          "inputs": {
            "seconds": {
              "fields": {
                "value": "60"
              },
              "op": "literal"
            }
          },
          "op": "timer.every"
        }
      }
    ],
    "widgets": [
      {
        "name": "Aincrad floor",
        "widget": {
          "height": 70,
          "props": {
            "label": "Floor",
            "show": "bar",
            "source": "script:aincrad.floor-counter/Floor"
          },
          "type": "stat",
          "width": 260
        }
      }
    ]
  },
  "version": "1.0"
}